# ============================================================
# Panchayat Weather Intelligence System - Environment Variables
# ============================================================

# Database (PostgreSQL + PostGIS)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_panchayat
POSTGRES_DB=panchayat_weather

# Backend (NestJS)
BACKEND_PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres_password_panchayat@db:5432/panchayat_weather
ML_SERVICE_URL=http://ml-service:8000

# ML Service (FastAPI)
ML_SERVICE_PORT=8000
ML_ENV=development
MODEL_VERSION=v0.1.0-alpha

# Frontend (Next.js)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME="Panchayat Weather Intelligence Platform"
